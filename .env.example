# 複製成 .env 後填入自己的金鑰（.env 已被 .gitignore 排除）。
#
# Google Maps API Key：
#   Web     → Maps JavaScript API
#   Android → Maps SDK for Android
#   iOS     → Maps SDK for iOS
#
# 留空或整個檔案不存在時，地圖會自動退回 OpenStreetMap 底圖。
GOOGLE_MAPS_API_KEY=

# OpenRouter API Key：還車照片的 L1（Gemini 3.7 Flash 快篩）與
# L2（Claude Opus 5 影像確認）都走這把金鑰。api/ 讀的是這個檔。
#   https://openrouter.ai/keys
# 沒有金鑰時後端會回 500，App 探測不到服務就退回腳本情境，不會壞掉。
OPENROUTER_API_KEY=

# 選填：換模型不用改程式
# L1_MODEL=google/gemini-3.7-flash
# L2_MODEL=anthropic/claude-opus-5
