app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# iRent Pulse 專案自訂規則
# 註：Pods/、key.properties、*.jks、local.properties 已由 ios/.gitignore
# 與 android/.gitignore 涵蓋，這裡不重複。
# ---------------------------------------------------------------------------

# 環境變數與機密設定（API 金鑰、後端位址等）
# 請改為提交 .env.example 當範本
.env
.env.*
!.env.example
secrets.json
*.secret

# 服務帳號金鑰
service-account*.json
*-serviceaccount.json
firebase-adminsdk*.json

# iOS 簽章憑證與描述檔
*.p12
*.pem
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# 編輯器 / 工具
*.iml
.fvm/
.vscode/settings.json
.claude/settings.local.json

# 模型權重與大型資產：CV 車損辨識模型請走 Git LFS 或外部儲存，
# 不要直接進版控。若確定要提交，於下方加白名單例外。
*.tflite
*.onnx
*.pt
*.pth
*.mlmodel
*.mlpackage

# 測試與分析產出
/coverage/
test/**/failures/
*.lcov
